<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>openphoton</AssemblyName>
    <RootNamespace>OpenPhoton.Server</RootNamespace>

    <Version>0.1.0</Version>
    <Product>OpenPhoton</Product>
    <Description>An open-source Photon Server 5 compatible realtime server.</Description>

    <!--
      Trimming is off deliberately. Plugins are loaded by reflection from assemblies the
      trimmer never sees, so it would strip exactly the types a plugin needs and the failure
      would land at a plugin author's feet rather than here.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenPhoton.Transport\OpenPhoton.Transport.csproj" />
    <ProjectReference Include="..\OpenPhoton.Realtime\OpenPhoton.Realtime.csproj" />
    <ProjectReference Include="..\OpenPhoton.HivePlugin\OpenPhoton.HivePlugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Photon plugins are commonly .NET Framework assemblies. Framework-targeted
      dependencies such as Newtonsoft.Json's net45 build still bind to the old
      Code Access Security facade when hosted on modern .NET. Keep the compatibility
      assembly in the default load context so isolated plugin contexts can fall back
      to it without every legacy plugin having to carry its own framework shim.
    -->
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
  </ItemGroup>

</Project>
